CONFIG_IDF_TARGET="esp32s3"

# Enable automatic rollback if new firmware image doesn't mark itself as "valid"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Don't include build timestamp so the binary is reproducible
CONFIG_BOOTLOADER_COMPILE_TIME_DATE=n

# Must match the [flash] section of espflash.toml
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Communicate over the JTAG port since we don't have good access to the serial port
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y
